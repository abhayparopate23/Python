{
  "manifest_version": 3,
  "name": "LinkedIn Experience Copier",
  "version": "2.6.34",
  "description": "Bulk LinkedIn profile opener and QA capture tool with editable keyword screening and Excel reporting.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_title": "LinkedIn Experience Copier",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
